---
import DefaultPage from '../layouts/DefaultPage.astro';
---

<DefaultPage title="Fotos - Brekkenrace">
<div class="content">
	<h1>Fotos Brekkenrace</h1>
	<p>Hier vind je foto's van alle Brekkenraces door de jaren heen.</p>
	
	<div class="years-grid">
		<div class="year-card">
			<a href="/fotos/2025" class="year-link">
				<div class="year-preview">
					<img src="/fotos/2025/thumbnails/Brekkenrace2025.jpg" alt="Brekkenrace 2025" />
				</div>
				<h2>2025</h2>
				<p>134 foto's</p>
			</a>
		</div>
	</div>
</div>
</DefaultPage>

<style>
	.content {
		margin: 0 auto;
		max-width: 1200px;
		padding: 0 1rem;
	}

	.years-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	.year-card {
		background: white;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.year-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
	}

	.year-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.year-preview {
		height: 200px;
		overflow: hidden;
	}

	.year-preview img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.year-card h2 {
		margin: 1rem;
		font-size: 1.5rem;
		color: var(--accent);
	}

	.year-card p {
		margin: 0 1rem 1rem;
		color: #666;
	}

	@media (max-width: 768px) {
		.years-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
