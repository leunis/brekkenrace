---
import DefaultPage from '../../layouts/DefaultPage.astro';
import PhotoModal from '../../components/PhotoModal.astro';

// Get all photo files
import { readdir } from 'fs/promises';
import path from 'path';

const photosDir = path.join(process.cwd(), 'public/fotos/2025');
let photoFiles = [];

try {
	const files = await readdir(photosDir);
	photoFiles = files
		.filter(file => file.toLowerCase().endsWith('.jpg') && file !== 'thumbnails')
		.sort((a, b) => {
			// Extract numbers from filenames for proper sorting
			const aNum = parseInt(a.match(/\d+/)?.[0] || '0');
			const bNum = parseInt(b.match(/\d+/)?.[0] || '0');
			return aNum - bNum;
		});
} catch (error) {
	console.error('Error reading photos directory:', error);
}
---

<DefaultPage title="Fotos Brekkenrace 2025">
<div class="content">
	<div class="header">
		<a href="/fotos" class="back-link">← Terug naar fotos</a>
		<h1>Brekkenrace 2025</h1>
		<p>{photoFiles.length} foto's</p>
	</div>
	
	<div class="photo-grid">
		{photoFiles.map((photo) => (
			<div class="photo-item">
				<img 
					src={`/fotos/2025/thumbnails/${photo}`}
					alt={`Brekkenrace 2025 - ${photo}`}
					loading="lazy"
					onclick={`openPhotoModal('/fotos/2025/thumbnails/${photo}', '/fotos/2025/${photo}', '${photo}')`}
				/>
			</div>
		))}
	</div>
</div>

<PhotoModal />
</DefaultPage>

<style>
	.content {
		margin: 0 auto;
		max-width: 1400px;
		padding: 0 1rem;
	}

	.header {
		margin-bottom: 2rem;
		text-align: center;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--accent);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	.back-link:hover {
		color: var(--accent-dark, #1a5490);
	}

	.header h1 {
		margin: 0.5rem 0;
		color: var(--accent);
	}

	.header p {
		color: #666;
		font-size: 1.1rem;
	}

	.photo-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin-top: 2rem;
	}

	.photo-item {
		aspect-ratio: 4/3;
		overflow: hidden;
		border-radius: 8px;
		cursor: pointer;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		background: #f5f5f5;
	}

	.photo-item:hover {
		transform: scale(1.05);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
	}

	.photo-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.3s ease;
	}

	.photo-item img:hover {
		opacity: 0.9;
	}

	/* Mobile: 2 per row */
	@media (max-width: 768px) {
		.photo-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
		}

		.header {
			text-align: left;
		}

		.header h1 {
			font-size: 1.5rem;
		}
	}

	/* Tablet: 3 per row */
	@media (min-width: 769px) and (max-width: 1024px) {
		.photo-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	/* Large screens: 4 per row (default) */
	@media (min-width: 1025px) {
		.photo-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	/* Loading state */
	.photo-item img[loading="lazy"] {
		background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
		background-size: 200% 100%;
		animation: loading 1.5s infinite;
	}

	@keyframes loading {
		0% {
			background-position: 200% 0;
		}
		100% {
			background-position: -200% 0;
		}
	}
</style>
